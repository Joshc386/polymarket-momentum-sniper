# Polymarket credentials
POLYMARKET_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE
POLYMARKET_FUNDER_ADDRESS=0xYOUR_FUNDER_ADDRESS_HERE
POLYMARKET_SIGNATURE_TYPE=1  # 1=email/Magic, 0=EOA

# Polygon RPC (for Chainlink oracle reads)
POLYGON_RPC_URL=https://polygon-rpc.com

# Telegram notifications
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Coinalyze API (cross-exchange sentiment data)
COINALYZE_API_KEY=your_api_key_here

# Dune Analytics API (SM wallet refresh for L9)
DUNE_API_KEY=your_dune_api_key_here
